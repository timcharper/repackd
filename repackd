ARCH_MAP = {"x86_64": "amd64", "aarch64": "arm64"}
SCRIPTS = ("preinst", "postinst", "prerm", "postrm")
MAX_INDEX = 256 << 20
MAX_DEB = 4 << 30
KEY_NAME = "RPM-GPG-KEY-repackd"
REPO_NAME = "repo"  # URL path of the one repo dnf sees; not usable as a recipe name
SIGN_UID = "repackd local signing key <repackd@localhost>"

